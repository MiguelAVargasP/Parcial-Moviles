<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permiso de "firma": solo apps firmadas con la misma llave (ahora todo es una sola app)
      pueden usar el servicio de scores. Se declara en todas las apps (este manifest se
      mezcla en cada una), así no importa en qué orden se instalen.
    -->
    <permission
        android:name="edu.upb.arcade.permission.SCORES"
        android:label="Guardar scores en Arcade UPB"
        android:protectionLevel="signature" />

    <uses-permission android:name="edu.upb.arcade.permission.SCORES" />

</manifest>
